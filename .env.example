# Bayanihan: Disaster Rescue — database connection
#
# Copy this file to .env and fill in your own Supabase project details:
#   cp .env.example .env
#
# Then generate the file the page actually loads:
#   sh tools/env-to-config.sh
#
# .env and the generated config.js are both listed in .gitignore and must
# never be committed.
#
# ---------------------------------------------------------------------------
# WHERE TO FIND THESE
#   Supabase dashboard -> Project Settings -> API
#     Project URL          -> SUPABASE_URL
#     Project API keys     -> anon / public  -> SUPABASE_ANON_KEY
#
# ONLY EVER USE THE ANON / PUBLIC KEY HERE.
#
# This is a browser game with no server of its own, so whatever goes in here
# is compiled into config.js and shipped to every player's browser. Anyone
# can read it with View Source. That is fine for the anon key — it is designed
# to be public, and Row Level Security in db/schema.sql is what actually
# protects the table.
#
# The service_role key bypasses Row Level Security completely. Putting it here
# would hand every player full read and write access to the database. Never.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
